/target/
**/target/

# Application — always commit Cargo.lock for reproducible builds (not .gitignored)
# Cargo.lock removed from ignore list
*.toml.patch
/evaluation/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment (templates committed via .env.example)
.env
.env.local
.env.*.local
docker/docker-compose.override.yml
*.log

# Certificates and keys (never commit these)
*.pem
!*.example.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
ca_key.pem
ca_key_test.pem

# OS
.DS_Store
Thumbs.db

# Test coverage
*.prof
*.sym
*.pdb

# Fuzz testing outputs (cargo-fuzz creates corpus, artifacts in project root)
**/fuzz/**/corpus/
**/fuzz/**/artifacts/
**/fuzz/**/crash-*
**/fuzz/**/*.options
**/fuzz/**/*.launcher
**/fuzz/**/target/

# SBOM output (generated by CI)
kms-sbom.cdx.json
kms-sbom.cdx.xml
sbom.cdx.json

# ZAP scan reports (generated)
tests/zap/reports/*.html
tests/zap/reports/*.json
tests/zap/reports/*.md
!tests/zap/reports/.gitkeep
tests/zap/zap-run-config.yaml

# docs output (generated)
docs/book/

# Fuzz project Cargo.lock (cargo-fuzz regenerates it constantly); the root Cargo.lock
# stays committed for reproducible application builds
/fuzz/Cargo.lock

# Internal audit / compliance docs — NOT for the public repo
docs/compliance/

# mcp
.mcp.json